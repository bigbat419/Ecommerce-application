# ── Flamingos — Local Development ────────────────────────────────────────────
SITE_NAME=Flamingos
SITE_TAGLINE=Shop Smarter. Live Better.

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=flamingos-dev-secret-change-in-production

# ── Database  (using the existing ecommerce_db that is already on the server) ──
MYSQL_HOST=127.0.0.1
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=ecommerce_db

# ── File Uploads ───────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads

# ── Paystack (replace with real test keys) ────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public
