# ── Flamingos Ecommerce Platform ─────────────────────────────────────────────
SITE_NAME=Flamingos
SITE_TAGLINE=Style That Speaks

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string-in-production

# ── Database ─────────────────────────────────────────────────────────────────
MYSQL_HOST=db
MYSQL_USER=root
MYSQL_PASSWORD=example
MYSQL_DB=flamingos_db

# ── File Uploads ─────���───────────────────────────────────────────────────────
UPLOAD_FOLDER=/data/uploads

# ── AWS S3 (optional — leave blank to use local storage) ──────────────────────
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=your_bucket
AWS_S3_REGION=us-east-1

# ── Stripe (optional) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public

# ── Admin seed ────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@flamingos.com
ADMIN_PASSWORD=adminpass
